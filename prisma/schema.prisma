// This is your Prisma schema file
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Role {
  customer
  admin
}

enum TrainRequestStatus {
  AVAILABLE
  IN_RESERVATION
  ASSIGNED
  DEPARTED
  COMPLETED
  CANCELLED
}

enum RequestType {
  LOCOMOTIVE_AND_PERSONNEL
  PERSONNEL_ONLY
  LOCOMOTIVE_ONLY
}

enum LocomotiveRequirement {
  ELECTRIC
  DIESEL_VLOK
  DUAL_MODE
  ANY_SUITABLE
}

enum TractionType {
  AC_15KV
  AC_25KV
  DC_3KV
  DC_1_5KV
  DIESEL
}

enum Region {
  NORD
  SUED
  WEST
  OST
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

// ─── MODELS ───────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  name             String    @db.VarChar(100)
  email            String    @unique @db.VarChar(200)
  companyName      String?   @db.VarChar(150)
  evuCode          String?   @db.VarChar(50)
  passwordHash     String
  role             Role      @default(customer)
  isActive         Boolean   @default(true)
  refreshToken     String?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  trains           Train[]   @relation("PublishedTrains")
  lockedTrains     Train[]   @relation("TrainLock")
  bids             Bid[]
  notifications    Notification[]

  @@index([email])
  @@index([role])
}

model Train {
  id                        String                @id @default(cuid())
  trainNumber               Int
  movementType              String?               @db.VarChar(50)
  
  // Location
  operatingPoint            String                @db.VarChar(50)
  stationId                 String?               @db.VarChar(50)
  stationName               String                @db.VarChar(200)
  region                    Region
  lat                       Float?
  lng                       Float?
  
  // Specs
  trainLength               Float?
  totalWeight               Float?
  numberOfWagons            Int?
  
  customerReference         String                @db.VarChar(100)
  
  // Requirements
  requestType               RequestType
  locomotiveRequirement     LocomotiveRequirement?
  existingLocomotive        String?               @db.VarChar(100)
  traction                  TractionType?
  
  // Destination
  destinationStation        String?               @db.VarChar(200)
  destinationOperatingPoint String?               @db.VarChar(50)
  destLat                   Float?
  destLng                   Float?
  
  // Scheduling
  requiredDeparture         DateTime?
  requiredArrival           DateTime?
  parkedFrom                DateTime
  expectedParkedUntil       DateTime
  actualDepartureTime       DateTime?
  
  parkingTrack              String?               @db.VarChar(100)
  afterArrivalAction        String?               @db.VarChar(500)
  
  status                    TrainRequestStatus    @default(AVAILABLE)
  
  // Locking
  lockedUntil               DateTime?
  lockedByUserId            String?
  lockedByUser              User?                 @relation("TrainLock", fields: [lockedByUserId], references: [id])
  
  // Publisher
  publishedById             String
  publishedBy               User                  @relation("PublishedTrains", fields: [publishedById], references: [id])
  
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  
  history                   TrainHistory[]
  bids                      Bid[]
  updates                   OperationalUpdate[]

  @@index([status])
  @@index([trainNumber])
  @@index([publishedById])
}

model Bid {
  id                String    @id @default(cuid())
  trainId           String
  train             Train     @relation(fields: [trainId], references: [id], onDelete: Cascade)
  
  bidderId          String
  bidder            User      @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  
  priceOffer        Float
  locomotiveDetails String?   @db.VarChar(500)
  driverEta         String?   @db.VarChar(100)
  comments          String?   @db.VarChar(1000)
  
  status            BidStatus @default(PENDING)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([trainId])
  @@index([bidderId])
  @@index([status])
}

model OperationalUpdate {
  id         String   @id @default(cuid())
  trainId    String
  train      Train    @relation(fields: [trainId], references: [id], onDelete: Cascade)
  
  message    String   @db.VarChar(1000)
  authorId   String
  
  createdAt  DateTime @default(now())
  
  @@index([trainId])
}

model TrainHistory {
  id         String   @id @default(cuid())
  trainId    String
  train      Train    @relation(fields: [trainId], references: [id], onDelete: Cascade)
  
  fromStatus String?
  toStatus   String
  notes      String?  @db.VarChar(500)
  
  changedAt  DateTime @default(now())
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title      String   @db.VarChar(100)
  message    String   @db.VarChar(500)
  isRead     Boolean  @default(false)
  link       String?  @db.VarChar(200)
  
  createdAt  DateTime @default(now())
  
  @@index([userId])
  @@index([isRead])
}
